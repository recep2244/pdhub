// Nextflow config for the Protein Design Hub predict→evaluate pipeline.
// Profiles let the same pipeline run locally, on a GPU box, or via containers.

manifest {
    name        = 'pdhub-predict-evaluate'
    description  = 'Reproducible protein structure predict → evaluate pipeline'
    mainScript  = 'predict_evaluate.nf'
    nextflowVersion = '>=23.10.0'
}

params {
    input     = null
    predictor = 'esmfold'
    metrics   = 'clash_score,sasa,contact_energy,disorder'
    outdir    = 'results'
    pdhub     = 'pdhub'
}

profiles {
    standard {
        process.executor = 'local'
    }
    gpu {
        // ESMFold/Chai/Boltz prediction wants a GPU; keep prediction serialised
        // so it doesn't oversubscribe one card, but evaluate can parallelise.
        process.executor = 'local'
        process {
            withName: PREDICT  { maxForks = 1 }
            withName: EVALUATE { maxForks = 4 }
        }
    }
    docker {
        docker.enabled = true
        process.container = 'pdhub:latest'
    }
}

// Reproducibility: per-run provenance reports.
timeline { enabled = true; file = "${params.outdir}/pipeline_timeline.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_report.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_trace.txt" }
